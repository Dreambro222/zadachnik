# Telegram bot token from @BotFather
BOT_TOKEN=123456:AAAA-your-token-here

# Comma-separated Telegram user IDs allowed to use the bot.
# Only these users can interact with the bot. Get yours from @userinfobot.
ALLOWED_USER_IDS=123456789

# TON network: mainnet | testnet
TON_NETWORK=mainnet

# Path to SQLite DB (relative to bot/, or absolute)
DB_PATH=./data/bot.db

# Master encryption salt — random string, never change after first run.
# If you change it, all stored private keys become unreadable.
MASTER_SALT=change-me-to-a-random-string-32+chars

# Optional: TON Center API key for higher RPC rate limits (toncenter.com)
TONCENTER_API_KEY=

# Order watcher poll interval (seconds) for stop-loss / take-profit
ORDER_POLL_INTERVAL=15

# Default DEX: stonfi | dedust
DEFAULT_DEX=stonfi

# Default slippage (percent) for swaps
DEFAULT_SLIPPAGE=1.0
