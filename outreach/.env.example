# Claude CLI executable (defaults to "claude" on PATH)
CLAUDE_BIN=claude

# Optional: model override for analyses (defaults to whatever `claude` uses)
# CLAUDE_MODEL=claude-sonnet-4-6

# Browser automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=20000

# Per-lead daily/hourly throttle (form submissions)
RATE_LIMIT_PER_HOUR=15

# ----------------------------------------------------------------------
# Sender identity (also used in POPIA s.69 footer)
# ----------------------------------------------------------------------
SENDER_NAME="Your Name"
SENDER_COMPANY="Your Company OU"
SENDER_EMAIL="you@your-outreach-domain.com"
SENDER_PHONE="+971 4 000 0000"
SENDER_WEBSITE="https://your-outreach-domain.com"

# ----------------------------------------------------------------------
# Outbound mail (SMTP)
# ----------------------------------------------------------------------
# Use a DEDICATED outreach domain — never your main corporate domain.
# Example providers:
#   - Google Workspace: smtp.gmail.com:587, app password (NOT main pw)
#   - Zoho Mail:        smtp.zoho.eu:587 / smtp.zoho.com:587
#   - Fastmail:         smtp.fastmail.com:465 (SSL)
#   - Custom:           your hosting provider's SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=outreach@your-outreach-domain.com
SMTP_PASSWORD=app-password-here
SMTP_USE_TLS=true
# false = plain SSL on port 465; true = STARTTLS on port 587

SMTP_FROM_NAME="Your Name"
SMTP_FROM_EMAIL=outreach@your-outreach-domain.com
# REPLY_TO is optional. If set, replies route to a different inbox (e.g.
# you send from outreach@ but want replies to land at sales@).
# REPLY_TO=sales@your-outreach-domain.com

# Per-day soft cap; the mailer refuses to exceed it. Start low, ramp slowly.
MAIL_DAILY_LIMIT=20
MAIL_DELAY_SECONDS=60

# ----------------------------------------------------------------------
# Inbound mail (IMAP) — same mailbox as SMTP_USER usually
# ----------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=outreach@your-outreach-domain.com
IMAP_PASSWORD=app-password-here
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

